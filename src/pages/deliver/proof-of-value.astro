        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasPlayed) {
            video.play().then(() => { hasPlayed = true; }).catch(() => {});
          } else if (!entry.isIntersecting && !video.paused) {
            video.pause();
          }
        });
      }, { threshold: 0.5 });
      io.observe(video);
    })();
  </script>
</BaseLayout>
