  <section id="dvf" class="bg-cream py-20 scroll-mt-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="reveal flex items-center gap-3 mb-6">
        <div class="w-10 h-10 bg-phase-deliver rounded-xl flex items-center justify-center text-white font-bold">7</div>
