import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils/base';

// Bell curve berekening voor Rogers' diffusion curve
const N = 80;
const mu = 0.5;
const sigma = 0.15;
const xStart = 80;
const xEnd = 920;
const yBase = 380;
const yPeak = 90;

const pts: [number, number][] = [];
for (let i = 0; i <= N; i++) {
  const t = i / N;
  const xPx = xStart + t * (xEnd - xStart);
  const z = (t - mu) / sigma;
  const yVal = Math.exp(-z * z / 2);
  const yPx = yBase - yVal * (yBase - yPeak);
  pts.push([xPx, yPx]);
}
const linePath = 'M ' + pts.map(p => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' L ');
const fillPath = linePath + ` L ${xEnd.toFixed(1)} ${yBase} L ${xStart.toFixed(1)} ${yBase} Z`;

const tToX = (t: number) => xStart + t * (xEnd - xStart);

// Y van curve op gegeven t
const yAtT = (t: number) => {
  const z = (t - mu) / sigma;
  const yVal = Math.exp(-z * z / 2);
  return yBase - yVal * (yBase - yPeak);
};

const categorieGrenzen = [0.206, 0.351, 0.5, 0.649];

const adopterBands = [
  { label: 'Innovators', pct: '2,5%', midT: 0.10, kleur: '#86efac' },
