---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/base';

const phases = [
  {
    title: 'Discover',
    subtitle: 'Divergeren: de wereld verkennen',
    description: 'Breed kijken: trendanalyse, scenariobouwing, immersive research en het formuleren van innovatie-challenges.',
    href: url('/discover/'),
    phase: 'discover',
    label: 'Fase 1',
    color: '#F47264',
    number: '01',
    evidenceCount: 4,
  },
  {
    title: 'Define',
    subtitle: 'Convergeren: richting bepalen',
    description: 'Innovatieradar, PMI-convergentie en twee denkrichtingen met HZWK-challenges.',
    href: url('/define/'),
    phase: 'define',
    label: 'Fase 2',
    color: '#3B82F6',
    number: '02',
    evidenceCount: 3,
  },
  {
    title: 'Design',
    subtitle: 'Divergeren: concepten verkennen',
    description: 'Gate met DVF en value curve, en een concept collection voor de gekozen denkrichting.',
    href: url('/design/'),
    phase: 'design',
    label: 'Fase 3',
    color: '#A78BFA',
    number: '03',
    evidenceCount: 2,
  },
  {
    title: 'Refine',
    subtitle: 'Convergeren: bouwen, testen, kiezen',
    description: 'Prototypen bouwen, testen met gebruikers en itereren via de PELV-cyclus.',
    href: url('/refine/'),
    phase: 'refine',
    label: 'Fase 4',
    color: '#F59E0B',
    number: '04',
    evidenceCount: 2,
  },
  {
    title: 'Deliver',
    subtitle: 'Het verhaal afronden',
    description: 'Het uiteindelijke Proof of Value presenteren en het innovatieadvies formuleren.',
    href: url('/deliver/'),
    phase: 'deliver',
    label: 'Fase 5',
    color: '#22C55E',
    number: '05',
    evidenceCount: 3,
  },
];
---

<BaseLayout title="Home">
  <!-- Hero + Landschap + Fasen + CTA in 1 view -->
  <section class="relative min-h-screen flex flex-col justify-center overflow-hidden glow-hero py-12 md:py-16">
    <!-- Decorative glow orbs -->
    <div class="absolute top-20 right-1/4 w-96 h-96 rounded-full blur-3xl pointer-events-none" style="background: rgba(139, 92, 246, 0.12);"></div>
    <div class="absolute bottom-20 left-1/4 w-72 h-72 rounded-full blur-3xl pointer-events-none" style="background: rgba(217, 70, 239, 0.08);"></div>

    <div class="max-w-7xl w-full mx-auto px-6 md:px-12 relative z-10">
      <!-- Titel + subtitel -->
      <div class="text-center">
        <div class="reveal">
          <p class="label text-sm mb-4">Innovatiemanagement EDIM.21</p>
        </div>
        <h1 class="font-[family-name:var(--font-display)] leading-[0.95] mb-4 reveal reveal-delay-1" style="font-size: clamp(2.75rem, 7vw, 5.5rem);">
          <span class="hw-word hw-word-inline text-text-primary" aria-label="Beyond">
            {'Beyond'.split('').map((letter, i) => (
              <span class="hw-letter" style={`animation-delay: ${0.5 + i * 0.12}s`}>{letter}</span>
            ))}
            <span class="hw-cursor" style={`animation-delay: 0.5s; animation-duration: ${0.12 * 6}s`}></span>
          </span>
          <br />
          <span class="hw-word hw-word-inline text-accent-magenta" aria-label="Paper">
            {'Paper'.split('').map((letter, i) => (
              <span class="hw-letter" style={`animation-delay: ${1.4 + i * 0.12}s`}>{letter}</span>
            ))}
            <span class="hw-cursor hw-cursor-2" style={`animation-delay: 1.4s; animation-duration: ${0.12 * 5}s`}></span>
          </span>
        </h1>
        <div class="reveal reveal-delay-2 max-w-2xl mx-auto">
          <p class="text-base md:text-lg text-text-secondary leading-relaxed">
            Hoe kan <strong class="text-text-primary font-normal">Aurora Writing Instruments Group</strong> relevant blijven in een wereld waarin schrijven en tekenen steeds digitaler worden?
          </p>
        </div>
      </div>

      <!-- Landschap afbeelding -->
      <div class="reveal reveal-delay-3 relative landschap-fade mt-4 md:mt-6 max-w-5xl mx-auto">
        <img
          src={url('/images/innovatiereis-landschap.png')}
          alt="3D landschap met de vijf fasen van het innovatieproces als stations"
          class="w-full h-auto block"
        />
      </div>

      <!-- Fasen per station onder het landschap -->
      <div class="reveal reveal-delay-3 grid grid-cols-5 gap-2 md:gap-4 -mt-2 md:-mt-4 max-w-5xl mx-auto">
        {phases.map((phase) => (
          <a
            href={phase.href}
            class="group flex flex-col items-center text-center px-1 py-2 rounded-lg transition-all duration-300 hover:bg-bg-secondary/50"
          >
            <span
              class="w-2.5 h-2.5 rounded-full mb-2"
              style={`background-color: ${phase.color}; box-shadow: 0 0 12px ${phase.color}80;`}
            ></span>
            <h3 class="font-[family-name:var(--font-display)] text-lg md:text-2xl group-hover:scale-105 transition-transform" style={`color: ${phase.color};`}>
              {phase.title}
            </h3>
            <span class="text-[10px] md:text-xs text-text-muted mt-0.5 mb-1">{phase.label}</span>
            <p class="text-[11px] md:text-xs text-text-secondary leading-snug hidden md:block">{phase.subtitle}</p>
          </a>
        ))}
      </div>

      <!-- CTA button onderaan -->
      <div class="reveal reveal-delay-3 mt-6 md:mt-8 flex justify-center">
        <a href={url('/aanleiding/')} class="btn-primary">
          Start de reis
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 5v14M5 12l7 7 7-7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="over" class="relative overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(139, 92, 246, 0.08), transparent);"></div>
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32 relative z-10">
      <div class="reveal max-w-3xl mx-auto text-center">
        <h2 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl text-text-primary mb-8">Over dit portfolio</h2>
        <p class="text-text-secondary text-lg leading-relaxed mb-6">
          <strong class="text-text-primary font-normal">De casus:</strong> <em>Aurora Writing Instruments Group is een fictieve
          maar realistische Nederlandse producent van potloden, pennen en tekenmaterialen met 125+ jaar
          historie.</em>
        </p>
        <p class="text-text-secondary text-lg leading-relaxed">
          <em>Dit is het innovatieportfolio voor het minorvak Innovatiemanagement (EDIM.21)
          van de opleiding Technische Bedrijfskunde. Het portfolio is opgebouwd
          als een reisverslag door het innovatieproces.</em>
        </p>
        <!-- Color bar with wavy style -->
        <div class="flex gap-2 mt-12 justify-center">
          {phases.map((phase) => (
            <div class="w-12 h-1.5 rounded-full" style={`background-color: ${phase.color}; opacity: 0.7;`}></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================================= -->
  <!-- STRUCTUURDOCUMENT (voor docent) -->
  <!-- ================================= -->

  <!-- Hoe leest u dit portfolio -->
  <section id="leeswijzer" class="bg-bg-secondary py-20 md:py-24 relative">
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="reveal max-w-3xl mx-auto text-center mb-14">
        <span class="text-accent-magenta font-bold text-sm tracking-widest uppercase mb-3 block">Structuurdocument</span>
        <h2 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl text-text-primary mb-6">Hoe leest u dit portfolio?</h2>
        <p class="text-text-secondary text-lg leading-relaxed">
          Deze site is zowel een reisverslag als een bewijsstukken-map voor het innovatieproces. Afhankelijk van wat u zoekt, zijn dit de snelste routes:
        </p>
      </div>

      <div class="reveal reveal-delay-1 grid md:grid-cols-3 gap-5">
        <div class="bg-bg-elevated rounded-2xl p-6 border border-white/5 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-phase-discover/20 text-phase-discover flex items-center justify-center font-bold mb-3">1</div>
          <h3 class="font-[family-name:var(--font-display)] font-bold text-text-primary text-lg mb-2">Voor de beoordelaar (docent)</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-3">
            Begin bij de <a href={url('/aanleiding/')} class="text-phase-discover underline">Aanleiding</a> om de casus te zien, loop dan door de fase-kleurpunten hierboven (Discover tot Deliver). Kritische reflecties en methodische beperkingen staan steeds op de fase-indexpagina's, bewijsstukken op de onderliggende pagina's.
          </p>
          <p class="text-text-secondary text-xs">Rubric-koppeling: zie sectie hieronder.</p>
        </div>

        <div class="bg-bg-elevated rounded-2xl p-6 border border-white/5 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-phase-deliver/20 text-phase-deliver flex items-center justify-center font-bold mb-3">2</div>
          <h3 class="font-[family-name:var(--font-display)] font-bold text-text-primary text-lg mb-2">Voor MT / directie</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-3">
            Spring direct naar de <a href={url('/deliver/proof-of-value/')} class="text-phase-deliver underline">Proof of Value</a> (concept, waarde, kosten, MT-vragen), aangevuld met het <a href={url('/deliver/ondernemingsplan/')} class="text-phase-deliver underline">ondernemingsplan</a> (BMC, 90-dagen plan) en de <a href={url('/deliver/roadmap/')} class="text-phase-deliver underline">roadmap</a>.
          </p>
          <p class="text-text-secondary text-xs">Beide zijn zelfstandig leesbaar.</p>
        </div>

        <div class="bg-bg-elevated rounded-2xl p-6 border border-white/5 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-accent-magenta/20 text-accent-magenta flex items-center justify-center font-bold mb-3">3</div>
          <h3 class="font-[family-name:var(--font-display)] font-bold text-text-primary text-lg mb-2">Voor de nieuwsgierige</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-3">
            Klik op "Start de reis" bovenaan en volg de chronologische route. Elke fase-index heeft een "Verder naar X"-link onderaan. Het verhaal gaat onverwachte kanten op, met twee grote bochten die we hieronder toelichten.
          </p>
          <p class="text-text-secondary text-xs">Over AI-gebruik: <a href={url('/genai/')} class="text-accent-magenta underline">zie GenAI-verantwoording</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Onze reis in 1 oogopslag: procesdiagram met 2 bochten -->
  <section id="reis" class="bg-bg-primary py-20 md:py-24 relative border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="reveal max-w-3xl mx-auto text-center mb-14">
        <h2 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl text-text-primary mb-6">Onze reis in 1 oogopslag</h2>
        <p class="text-text-secondary text-lg leading-relaxed">
          Hoe een potlodenfabrikant eindigde bij digitale verificatie. Twee bochten die we niet hadden voorspeld aan de start.
        </p>
      </div>

      <!-- Procesdiagram als horizontale lijn met bochten -->
      <div class="reveal reveal-delay-1 bg-bg-elevated rounded-3xl p-6 md:p-10 border border-white/10 shadow-lg">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
          {phases.map((phase, idx) => (
            <div class="relative">
              <a href={phase.href} class="block bg-bg-primary rounded-xl p-4 border border-white/5 hover:border-white/20 transition-colors">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-3 h-3 rounded-full" style={`background-color: ${phase.color}; box-shadow: 0 0 10px ${phase.color}80;`}></span>
                  <span class="text-text-muted text-xs">{phase.label}</span>
                </div>
                <h3 class="font-[family-name:var(--font-display)] font-bold text-base mb-1" style={`color: ${phase.color};`}>
                  {phase.title}
                </h3>
                <p class="text-text-secondary text-xs leading-snug">{phase.subtitle}</p>
              </a>
            </div>
          ))}
        </div>

        <!-- Twee bochten -->
        <div class="grid md:grid-cols-2 gap-4 mt-8">
          <div class="bg-phase-design/10 rounded-2xl p-6 border-l-4 border-phase-design">
            <p class="text-phase-design text-xs font-bold uppercase tracking-widest mb-2">Bocht 1: Gate 1 (Design)</p>
            <h4 class="font-[family-name:var(--font-display)] font-bold text-text-primary text-lg mb-2">Security gekozen, ondanks lagere DVF-totaalscore</h4>
            <p class="text-text-secondary text-sm leading-relaxed">
              Circulaire Standaard scoorde 74, Security 73. Toch Security, omdat de Desirability-voorsprong van Circulair rustte op een bedachte klant. Bij Security was de klant (notaris) en de pijn (handtekeningfraude) geobserveerd. Zie de <a href={url('/design/gate/')} class="text-phase-design underline">gate-afweging</a>.
            </p>
          </div>

          <div class="bg-phase-refine/10 rounded-2xl p-6 border-l-4 border-phase-refine">
            <p class="text-phase-refine text-xs font-bold uppercase tracking-widest mb-2">Bocht 2: Pivot (Refine)</p>
            <h4 class="font-[family-name:var(--font-display)] font-bold text-text-primary text-lg mb-2">Van slimme pen naar digitaal verificatieproces</h4>
            <p class="text-text-secondary text-sm leading-relaxed">
              Tijdens PELV-iteratie 2 (8 april) stelden 3 van 6 testers variaties op "wat doet die pen?". Een tester zei letterlijk: "de pen doet niks, het gaat om wat je scant". Op 13 april besloten we dat dit een probleemdefinitiekwestie was, geen prototype-verbetering. <a href={url('/refine/pivot/')} class="text-phase-refine underline">Pivot-moment methodisch</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bewijsstukken per opdracht-eis -->
  <section id="rubric" class="bg-bg-secondary py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="reveal max-w-3xl mx-auto text-center mb-12">
        <h2 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl text-text-primary mb-6">Bewijsstukken per opdracht-eis</h2>
        <p class="text-text-secondary text-lg leading-relaxed">
          Een checklist voor snelle mapping tegen de rubric. Elk onderdeel linkt direct naar het bewijsstuk op deze site.
        </p>
      </div>

      <div class="reveal reveal-delay-1 bg-bg-elevated rounded-2xl border border-white/10 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-bg-primary/50 text-text-muted text-xs uppercase tracking-widest">
              <th class="text-left py-3 px-4">Opdracht-eis</th>
              <th class="text-left py-3 px-4">Bewijsstuk</th>
              <th class="text-left py-3 px-4">Status</th>
            </tr>
          </thead>
          <tbody class="text-text-secondary">
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1a Discover: trendanalyse + scenariomatrix</td>
              <td class="py-3 px-4"><a href={url('/discover/trends/')} class="text-phase-discover underline">Trends</a> + <a href={url('/discover/scenario/')} class="text-phase-discover underline">Scenario</a></td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1a Discover: immersive research (minimaal 1,5 uur)</td>
              <td class="py-3 px-4"><a href={url('/discover/empathise/')} class="text-phase-discover underline">Empathise</a> (sessie 1 + 2, circa 2u45m totaal)</td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1a Discover: HZWK-challenges</td>
              <td class="py-3 px-4"><a href={url('/discover/challenges/')} class="text-phase-discover underline">Challenges</a> (5 HZWK's)</td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1b Define: innovatieradar + convergentie + denkrichtingen</td>
              <td class="py-3 px-4"><a href={url('/define/innovatieradar/')} class="text-phase-define underline">Radar</a> + <a href={url('/define/convergentie/')} class="text-phase-define underline">Convergentie</a> + <a href={url('/define/denkrichtingen/')} class="text-phase-define underline">Denkrichtingen</a></td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1b Define: projectvoorstellen per denkrichting</td>
              <td class="py-3 px-4"><a href={url('/define/projectvoorstellen/')} class="text-phase-define underline">Projectvoorstellen</a> (Security + Circulair)</td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1b Design: gate met DVF</td>
              <td class="py-3 px-4"><a href={url('/design/gate/')} class="text-phase-design underline">Design-gate</a> (DVF-subscores + ERRC + value curve)</td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1b Design: 2 concept collections</td>
              <td class="py-3 px-4"><a href={url('/design/concept-collection/')} class="text-phase-design underline">Concept collection</a> (1 uitgewerkt voor Security)</td>
              <td class="py-3 px-4"><span class="bg-accent-yellow/20 text-accent-yellow text-xs px-2 py-0.5 rounded">1 van 2, 2e verantwoord</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1c Refine: 2+ PELV-iteraties</td>
              <td class="py-3 px-4"><a href={url('/refine/prototyping/')} class="text-phase-refine underline">Prototyping</a> (iteratie 1: N=3 per concept, iteratie 2: N=6 met scores)</td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1c Refine: pivot / koerswijziging</td>
              <td class="py-3 px-4"><a href={url('/refine/pivot/')} class="text-phase-refine underline">Pivot</a> (herframe + VPC + procesflow)</td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1b Deliver: Proof of Value (MT-niveau)</td>
              <td class="py-3 px-4"><a href={url('/deliver/proof-of-value/')} class="text-phase-deliver underline">Proof of Value</a> (10 secties, MT-blindtest 8/10 duidelijk)</td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">1b Deliver: ondernemingsplan / roadmap</td>
              <td class="py-3 px-4"><a href={url('/deliver/ondernemingsplan/')} class="text-phase-deliver underline">BMC + 90-dagen plan</a> + <a href={url('/deliver/roadmap/')} class="text-phase-deliver underline">Roadmap</a></td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">Externe gate met domeinexpert</td>
              <td class="py-3 px-4">In <a href={url('/deliver/ondernemingsplan/#negentig-dagen')} class="text-phase-deliver underline">fase 1 van het 90-dagen plan</a> (week 7-10)</td>
              <td class="py-3 px-4"><span class="bg-phase-discover/30 text-phase-discover text-xs px-2 py-0.5 rounded">bewust in fase 1</span></td>
            </tr>
            <tr class="border-t border-white/5">
              <td class="py-3 px-4">GenAI-verantwoording</td>
              <td class="py-3 px-4"><a href={url('/genai/')} class="text-accent-magenta underline">GenAI-pagina</a> (tools, wat wel/niet, integriteit)</td>
              <td class="py-3 px-4"><span class="bg-phase-deliver/20 text-phase-deliver text-xs px-2 py-0.5 rounded">compleet</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="reveal reveal-delay-2 max-w-3xl mx-auto mt-6 bg-bg-elevated/50 rounded-xl p-5 border border-white/5">
        <p class="text-text-muted text-xs leading-relaxed">
          <strong class="text-text-primary">Over de twee gele markeringen:</strong> we hebben 1 concept collection uitgewerkt (Security) en de tweede expliciet niet gemaakt omdat Desirability voor Circulair onvoldoende geobserveerd was in Gate 1. Dat staat <a href={url('/design/concept-collection/')} class="text-phase-design underline">uitgelegd op de concept collection-pagina</a>. De externe gate (gesprek met notaris) staat in het 90-dagen plan als eerste stap van fase 1, niet als afgevinkte activiteit in deze leerfase. De rest van de eisen is afgerond.
        </p>
      </div>
    </div>
  </section>

  <!-- Reflectie op leerproces, team, oordeel eigen werk -->
  <section id="reflectie" class="bg-bg-primary py-20 md:py-24 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="reveal max-w-3xl mx-auto text-center mb-14">
        <h2 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl text-text-primary mb-6">Wat we hebben geleerd</h2>
        <p class="text-text-secondary text-lg leading-relaxed">
          Drie dingen die we eerlijk willen delen voordat u doorklikt.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <!-- Leerproces -->
        <div class="reveal reveal-delay-1 bg-bg-elevated rounded-2xl p-6 border border-white/10">
          <div class="text-phase-discover text-3xl mb-3">&#9683;</div>
          <h3 class="font-[family-name:var(--font-display)] font-bold text-text-primary text-lg mb-3">Over het proces</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-3">
            De grootste leer zat niet in de methoden maar in het loslaten. We hadden ons vastgebeten in "een slimme pen" en moesten door twee PELV-iteraties heen voordat we zagen dat de pen zelf het probleem niet was. Dat is methodisch goed (design thinking werkt zo), maar voelde eerst als falen.
          </p>
          <p class="text-text-secondary text-xs italic">
            Wat we meenemen: eerder luisteren naar terugkerende signalen uit testgesprekken, ook als ze je hoofdidee in twijfel trekken.
          </p>
        </div>

        <!-- Team -->
        <div class="reveal reveal-delay-2 bg-bg-elevated rounded-2xl p-6 border border-white/10">
          <div class="text-phase-define text-3xl mb-3">&#9788;</div>
          <h3 class="font-[family-name:var(--font-display)] font-bold text-text-primary text-lg mb-3">Over het team</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-3">
            We hebben ons team gescoord op tien innovatierollen uit het McKinsey-raamwerk voor innovatietalent (<a href="https://www.mckinsey.com/capabilities/strategy-and-corporate-finance/our-insights/the-eight-essentials-of-innovation" target="_blank" rel="noopener" class="text-phase-define underline">McKinsey</a>; vgl. Derksen 2012 voor een Nederlandstalige variant). Jr sterkst op Generating, Pioneering, Tabulating. Lianne op Networking, Pioneering. Anke op Motivating, Absorbing. Dat werkte goed voor divergentie en empathiseren, minder voor operationele uitvoering. De Tabulating-kant bij Lianne was een gat; voor een echte startup zou dat een extra persoon rechtvaardigen (zie <a href={url('/deliver/ondernemingsplan/#team')} class="text-phase-define underline">teamplan</a>).
          </p>
          <p class="text-text-secondary text-xs italic">
            Wat we meenemen: rolverdeling bewust bespreken aan de start, niet pas bij het schrijven van het ondernemingsplan.
          </p>
        </div>

        <!-- Eerlijk oordeel -->
        <div class="reveal reveal-delay-3 bg-bg-elevated rounded-2xl p-6 border border-white/10">
          <div class="text-phase-refine text-3xl mb-3">&#9873;</div>
          <h3 class="font-[family-name:var(--font-display)] font-bold text-text-primary text-lg mb-3">Eerlijk oordeel eigen werk</h3>
          <p class="text-text-secondary text-sm leading-relaxed mb-3">
            Waar dit portfolio sterk is: de reis-traceerbaarheid op <a href={url('/define/denkrichtingen/')} class="text-phase-refine underline">denkrichtingen</a>, het PELV-bewijs, het uitgewerkte ondernemingsplan en de eerlijke reflectie op bestaande spelers in pivot. Waar het minder is: alle tests bleven intern, geen echte notaris gesproken (die stap staat in het 90-dagen plan). De 32 ideeen op de radar bleven onder de aanbevolen 90, wat we niet met een tweede sessie hebben goedgemaakt.
          </p>
          <p class="text-text-secondary text-xs italic">
            Zelf-inschatting: goed tot zeer goed. Wat het van zeer goed naar uitmuntend zou brengen is een externe valideringsstem, die nu bewust is doorgeschoven.
          </p>
        </div>
      </div>

      <!-- Link naar GenAI -->
      <div class="reveal reveal-delay-3 mt-12 text-center">
        <a href={url('/genai/')} class="inline-flex items-center gap-2 bg-accent-magenta/10 text-accent-magenta border border-accent-magenta/30 hover:bg-accent-magenta/20 px-6 py-3 rounded-full text-sm font-medium transition-colors">
          Hoe hebben we AI gebruikt? Open verantwoording &rarr;
        </a>
      </div>
    </div>
  </section>
  <style>
    /* --- Landschap fade-out naar achtergrond --- */
    .landschap-fade {
      filter: brightness(0.95) contrast(1.02);
      -webkit-mask-image:
        linear-gradient(to bottom, transparent 0%, #000 4%, #000 96%, transparent 100%),
        linear-gradient(to right,  transparent 0%, #000 4%, #000 96%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to bottom, transparent 0%, #000 4%, #000 96%, transparent 100%),
        linear-gradient(to right,  transparent 0%, #000 4%, #000 96%, transparent 100%);
      mask-composite: intersect;
    }

    /* --- Letter-by-letter handwriting animation --- */
    .hw-word {
      position: relative;
      display: block;
    }
    .hw-word-inline {
      display: inline-block;
    }

    .hw-letter {
      display: inline-block;
      opacity: 0;
      transform: translateY(0.08em) rotate(-2deg) scale(0.8);
      animation: writeLetter 0.18s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
      transform-origin: bottom left;
    }

    @keyframes writeLetter {
      0% {
        opacity: 0;
        transform: translateY(0.08em) rotate(-3deg) scale(0.7);
      }
      60% {
        opacity: 1;
        transform: translateY(-0.02em) rotate(0.5deg) scale(1.02);
      }
      100% {
        opacity: 1;
        transform: translateY(0) rotate(0deg) scale(1);
      }
    }

    /* Pen cursor: small dot that moves ahead of the letters */
    .hw-cursor {
      position: absolute;
      bottom: 0.15em;
      left: 0;
      width: 6px;
      height: 6px;
      background: #D4AF37;
      border-radius: 50%;
      opacity: 0;
      pointer-events: none;
      box-shadow: 0 0 8px rgba(212, 175, 55, 0.6), 0 0 2px rgba(212, 175, 55, 0.9);
      animation:
        cursorShow 0.1s ease forwards,
        cursorMove 0.72s steps(6, end) forwards,
        cursorHide 0.2s ease forwards;
      /* cursorMove duration = letters * 0.12s */
      animation-delay: var(--cursor-delay, 0.5s), var(--cursor-delay, 0.5s), calc(var(--cursor-delay, 0.5s) + 0.75s);
    }

    .hw-cursor-2 {
      animation:
        cursorShow 0.1s ease forwards,
        cursorMove2 0.6s steps(5, end) forwards,
        cursorHide 0.2s ease forwards;
      animation-delay: 1.4s, 1.4s, 2.05s;
    }

    @keyframes cursorShow {
      to { opacity: 1; }
    }
    @keyframes cursorHide {
      to { opacity: 0; }
    }

    /* "Beyond" = 6 letters, each ~0.55em wide in Patrick Hand at this size */
    @keyframes cursorMove {
      0%   { left: 0; }
      16%  { left: 0.55em; }
      33%  { left: 1.1em; }
      50%  { left: 1.65em; }
      66%  { left: 2.2em; }
      83%  { left: 2.75em; }
      100% { left: 3.3em; }
    }

    /* "Paper" = 5 letters */
    @keyframes cursorMove2 {
      0%   { left: 0; }
      20%  { left: 0.55em; }
      40%  { left: 1.1em; }
      60%  { left: 1.65em; }
      80%  { left: 2.2em; }
      100% { left: 2.75em; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hw-letter {
        opacity: 1;
        transform: none;
        animation: none;
      }
      .hw-cursor { display: none; }
    }
  </style>
</BaseLayout>
