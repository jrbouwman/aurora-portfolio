---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/base';

const aiGebruik = [
  {
    tool: 'ChatGPT (OpenAI, GPT-5)',
    rol: 'Primaire bouwer',
    door: 'Jr',
    wanneer: 'Het hele traject, van eerste ideeen tot bouw van de site',
    wat: [
      'Eerste versies van uitleg-teksten per fase, daarna handmatig bijgeschaafd',
      'Astro-pagina\'s structureren en HTML/CSS-code schrijven',
      'Zoeken naar externe bronnen en voorstellen voor nuances',
      'Eerste versies van dit ondernemingsplan en de PoV-structuur',
    ],
  },
  {
    tool: 'Claude (Anthropic, Opus 4.7)',
    rol: 'Review en reflectie',
    door: 'Jr',
    wanneer: '19-20 april, in laatste ronde voor inlevering',
    wat: [
      'Kritisch doornemen van wat ChatGPT heeft gemaakt, onafhankelijk oordeel over kwaliteit',
      'Zoeken en citeren van externe bronnen (Fraudehelpdesk, Signicat, KNB, AFM)',
      'Schrijven van concept-documenten voor stukken die nog ontbraken (onderzoeksplan, ondernemingsplan-opzet)',
      'Herschrijven van claims die we niet konden onderbouwen (zoals de 15->3 min-aanname naar 10-15 min met bron)',
    ],
  },
  {
    tool: 'Nano Banana 3 / GPT-image',
    rol: 'Visuele ondersteuning',
    door: 'Jr',
    wanneer: 'Meerdere momenten door het project',
    wat: [
      'Homepage-landschap (3D-visualisatie van de vijf fasen als stations)',
      'Enkele sfeerbeelden in de concept collection die niet in Unsplash te vinden waren',
      'Hero-beelden voor sommige fase-pagina\'s',
    ],
  },
];

const integriteit = [
  { principe: 'Feitelijke claims teruggezocht op bronlocaties', uitleg: 'Alle cijfers die de AI voorstelde zijn handmatig gecontroleerd op bronnen die bereikbaar zijn. Waar de bron dood was of niet bestond (zoals een initiele "Betaalvereniging 2024"-link), zijn alternatieven gezocht en geciteerd.' },
  { principe: 'AI-toon actief weggeschreven', uitleg: 'Em-dashes in lopende tekst zijn vervangen door komma\'s of punten. "Niet X, maar Y"-constructies en taglines zijn waar mogelijk geschrapt. Corporate jargon ("paradigmashift", "als geen ander") is vervangen door gewone taal.' },
  { principe: 'Twee AI-systemen tegen elkaar ingezet', uitleg: 'ChatGPT voor bouwen, Claude voor review. Waar de twee AI\'s het oneens waren, is het oordeel handmatig gewogen. De review van Claude op ChatGPT\'s werk staat zelf ook in docs/onderzoek/review/.' },
  { principe: 'Oordeelsvorming blijft bij het team', uitleg: 'Inschatting DVF-scores, keuze tussen denkrichtingen, het pivot-moment, de interpretatie van interviews: dat zijn allemaal eigen keuzes. De AI\'s hebben voorstellen gedaan en zijn ingezet om de gevolgen door te rekenen, maar niet om de keuze te maken.' },
];
---

<BaseLayout title="GenAI-verantwoording">
  <!-- Hero -->
  <section class="bg-bg-primary text-white overflow-hidden relative">
    <div class="absolute inset-0 bg-gradient-to-b from-accent-magenta/10 to-bg-primary"></div>

    <div class="max-w-4xl mx-auto px-6 py-16 md:py-24 relative z-10">
      <nav class="reveal text-sm mb-6 flex items-center gap-2">
        <a href={url('/')} class="text-white/40 hover:text-white/60 transition-colors">Home</a>
        <span class="text-white/20">/</span>
        <span class="text-accent-magenta font-medium">GenAI-verantwoording</span>
      </nav>
      <h1 class="reveal reveal-delay-1 font-[family-name:var(--font-display)] text-5xl md:text-7xl font-bold leading-[0.95] mb-4">
        Hoe we <span class="gradient-text">AI</span> gebruikten
      </h1>
      <p class="reveal reveal-delay-2 text-xl text-white/60 max-w-3xl leading-relaxed">
        Eerlijk: AI heeft ons veel werk uit handen genomen. Deze pagina laat zien waarvoor, en waar we de oordeelsvorming bij ons zelf hielden.
      </p>
      <div class="reveal reveal-delay-3 w-24 h-1.5 rounded-full bg-accent-magenta mt-8"></div>
    </div>
  </section>

  <!-- Hoe we AI gebruikten -->
  <section class="bg-cream py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="reveal font-[family-name:var(--font-display)] text-3xl md:text-4xl font-bold text-dark mb-8 text-center">Welke tools, waarvoor?</h2>

      <div class="reveal reveal-delay-1 space-y-6">
        {aiGebruik.map((a) => (
          <div class="bg-bg-elevated rounded-2xl p-6 border border-white/10 shadow-sm">
            <div class="flex items-start justify-between gap-4 flex-wrap mb-3">
              <div>
                <h3 class="font-[family-name:var(--font-display)] font-bold text-dark text-lg">{a.tool}</h3>
                <p class="text-dark/50 text-sm">{a.rol}</p>
              </div>
              <div class="text-right">
                <p class="text-dark/40 text-xs font-bold uppercase tracking-widest">Gebruikt door</p>
                <p class="text-dark/70 text-sm">{a.door}</p>
              </div>
            </div>
            <p class="text-dark/50 text-sm italic mb-3">Moment: {a.wanneer}</p>
            <ul class="text-dark/70 text-sm leading-relaxed list-disc pl-5 space-y-1">
              {a.wat.map((w) => <li>{w}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Waar wel, waar niet -->
  <section class="bg-warm-gray py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="reveal font-[family-name:var(--font-display)] text-3xl md:text-4xl font-bold text-dark mb-8 text-center">Waar wel, waar niet?</h2>

      <div class="reveal reveal-delay-1 grid md:grid-cols-2 gap-6">
        <div class="bg-phase-deliver/5 border-l-4 border-phase-deliver rounded-r-2xl p-6">
          <p class="text-phase-deliver text-xs font-bold uppercase tracking-widest mb-3">Wel met AI</p>
          <ul class="text-dark/70 text-sm leading-relaxed list-disc pl-5 space-y-1.5">
            <li>Structureel opzet van pagina's (welke secties, welke volgorde)</li>
            <li>Eerste versie van uitleg-teksten en code</li>
            <li>Zoeken naar externe bronnen die we zelf niet zouden googelen</li>
            <li>Tegenspraak bij eigen aannames (vooral Claude's reviewers)</li>
            <li>Visuele elementen: landschap, sfeerbeelden</li>
          </ul>
        </div>
        <div class="bg-phase-discover/5 border-l-4 border-phase-discover rounded-r-2xl p-6">
          <p class="text-phase-discover text-xs font-bold uppercase tracking-widest mb-3">Niet met AI</p>
          <ul class="text-dark/70 text-sm leading-relaxed list-disc pl-5 space-y-1.5">
            <li>Eigen inschatting van DVF-scores op Gate 1 en Gate 2</li>
            <li>De keuze tussen Security en Circulaire Standaard</li>
            <li>Het besluit om te pivotten van de pen naar digitaal proces</li>
            <li>Interpretatie van interviews (wat betekenen Anna en Famke's antwoorden)</li>
            <li>Teamdynamiek-observaties (McKinsey-rollen) en beslissing welke kandidaat welke rol doet</li>
            <li>De leerreflecties ("wat werkte wel, wat niet") zijn door ons geschreven, niet door AI gegenereerd</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Integriteit bewaken -->
  <section class="bg-cream py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="reveal font-[family-name:var(--font-display)] text-3xl md:text-4xl font-bold text-dark mb-8 text-center">Hoe we de integriteit bewaakten</h2>

      <div class="reveal reveal-delay-1 space-y-4">
        {integriteit.map((i) => (
          <div class="bg-bg-elevated rounded-2xl p-6 border border-white/10 shadow-sm">
            <h3 class="font-[family-name:var(--font-display)] font-bold text-dark text-lg mb-2">{i.principe}</h3>
            <p class="text-dark/70 text-sm leading-relaxed">{i.uitleg}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Eerlijke reflectie -->
  <section class="bg-bg-primary text-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="reveal font-[family-name:var(--font-display)] text-3xl md:text-4xl font-bold mb-8 text-center">Wat werkte met AI, wat niet?</h2>

      <div class="reveal reveal-delay-1 grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="font-[family-name:var(--font-display)] font-bold text-phase-deliver text-lg mb-3">Werkte goed</h3>
          <ul class="text-white/70 text-sm leading-relaxed list-disc pl-5 space-y-2">
            <li>Snel structuur neerzetten voor een grote site (17 pagina's, in tempo dat we zelf nooit hadden gehaald)</li>
            <li>Bronnen vinden die buiten ons eigen googel-patroon lagen (Fraudehelpdesk Terugblik, VNG eIDAS-factsheet)</li>
            <li>Tweede lezing van eigen werk: Claude merkte feitelijke fouten in ChatGPT's eerste versies op (Huizingh-mapping, PELV-expansie)</li>
            <li>Schrijven tegen jezelf: een AI die eerst argumenteert en dan tegenargumenten geeft is verhelderend</li>
          </ul>
        </div>
        <div>
          <h3 class="font-[family-name:var(--font-display)] font-bold text-phase-discover text-lg mb-3">Werkte minder</h3>
          <ul class="text-white/70 text-sm leading-relaxed list-disc pl-5 space-y-2">
            <li>Theorie-attributie: AI's kennen de bronnen vaak niet precies en attribueren PELV aan Boehm of mixen Huizingh met Tidd &amp; Bessant. Moest handmatig worden gecorrigeerd.</li>
            <li>Oordeel over methodische juistheid: AI schrijft makkelijk dat iets "methodisch solide" is zonder de methode te kennen die de docent hanteert.</li>
            <li>AI-toon blijft terugkomen: em-dashes, parallelle opsommingen, concluderende afsluitzinnen. Moesten we iedere ronde opnieuw weghalen.</li>
            <li>Overtuigingskracht groter dan correctheid: een goed geformuleerde verkeerde claim overleeft soms langer dan een rommelige juiste claim.</li>
          </ul>
        </div>
      </div>

      <div class="reveal reveal-delay-2 mt-10 bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
        <p class="text-white/80 italic leading-relaxed max-w-2xl mx-auto">
          "AI heeft dit portfolio versneld, niet vervangen. Zonder AI hadden we niet zoveel pagina's kunnen maken. Met AI hadden we meer tijd om inhoudelijk te wegen wat er wel en niet in moest, en om te corrigeren waar AI-suggesties niet klopten."
        </p>
        <p class="text-white/40 text-xs mt-3">&mdash; Team Aurora, Innovatiemanagement 2025/26</p>
      </div>
    </div>
  </section>

  <!-- Navigatie -->
  <section class="bg-bg-secondary py-12">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <a href={url('/')} class="inline-flex items-center gap-2 text-phase-define hover:text-phase-define/80 font-bold transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Terug naar home
      </a>
    </div>
  </section>
</BaseLayout>
