---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils/base';

const productvormen = [
  'Ring met biometrische sensor',
  'Smartwatch-integratie',
  'Verificatiekastje voor op het bureau',
  'Handschoen met schrijfherkenning',
  'Bureaumat met druksensoren',
  'Stempel met identiteitsverificatie',
  'Telefoonhoesje met NFC',
  'Laptop-integratie',
];

const authenticatie = [
  'Iris-scan',
  'Vingerafdruk',
  'Schrijf-DNA (druk, snelheid, hoek, ritme)',
  'Klop-ritme als wachtwoord',
  'Danspatroon-herkenning',
  'Geurherkenning',
  'Stemherkenning',
  'Biometrische combinaties',
];

const kruisbestuivingen = [
  { naam: 'Octopus', waarom: 'Meerdere armen, meerdere verificatiemethoden tegelijk' },
  { naam: 'Papegaai', waarom: 'Nadoen van geluid of stem, maar net niet precies genoeg' },
  { naam: 'Vlinder', waarom: 'Metamorfose van rups naar vlinder, zelfde wezen onder andere vorm' },
  { naam: 'Banksy', waarom: 'Anonieme kunst die toch te authenticeren is' },
  { naam: 'Yoga', waarom: 'Lichaamshouding als uniek kenmerk' },
  { naam: 'Koken', waarom: 'Recept volgen met eigen interpretatie, net als handschrift' },
  { naam: 'Graffiti', waarom: 'Straatkunst met een tag als persoonlijke merk' },
];
---

<BaseLayout title="Concept Collection · Design">
  <!-- Hero -->
  <section class="bg-bg-primary text-white overflow-hidden relative">
    <div class="absolute inset-0">
      <img src={url('/images/research/denkrichting1-security-expert.jpeg')} alt="" class="w-full h-full object-cover opacity-15" />
      <div class="absolute inset-0 bg-gradient-to-b from-bg-primary/60 to-bg-primary"></div>
    </div>

    <div class="max-w-5xl mx-auto px-6 py-16 md:py-24 relative z-10">
      <nav class="reveal text-sm mb-6 flex items-center gap-2">
        <a href={url('/')} class="text-white/40 hover:text-white/60 transition-colors">Home</a>
        <span class="text-white/20">/</span>
        <a href={url('/design/')} class="text-white/40 hover:text-white/60 transition-colors">Design</a>
        <span class="text-white/20">/</span>
        <span class="text-phase-design font-medium">Concept Collection</span>
      </nav>
      <h1 class="reveal reveal-delay-1 font-[family-name:var(--font-display)] text-5xl md:text-7xl font-bold leading-[0.95] mb-4">
        Concept<br /><span class="gradient-text">Collection</span>
      </h1>
      <p class="reveal reveal-delay-2 text-xl text-white/60 max-w-3xl leading-relaxed">
        Een visuele verzamelbak rond authenticatie en verificatie. We hebben breed gezocht: technologie, natuur, kunst en rituelen. Kwantiteit stond voorop, convergeren deden we pas daarna.
      </p>
      <div class="reveal reveal-delay-3 w-24 h-1.5 rounded-full bg-phase-design mt-8"></div>
    </div>
  </section>

  <!-- Uitleg concept collection -->
  <section class="bg-cream py-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="reveal bg-bg-elevated rounded-3xl p-8 md:p-10 shadow-sm border border-white/5">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-phase-design rounded-2xl flex items-center justify-center text-white text-xl flex-shrink-0 font-bold">&#127912;</div>
          <div>
            <h2 class="font-[family-name:var(--font-display)] text-2xl font-bold text-dark mb-3">Wat is een concept collection?</h2>
            <p class="text-dark/60 leading-relaxed mb-3">
              Een concept collection is het resultaat van verzamelwoede. Je begint met een denkrichting en verzamelt alles wat er op wat voor manier dan ook mee te maken heeft. Kwantiteit telt: hoe meer je verzamelt, hoe meer verbanden je kunt leggen. Expliciet divergerend.
            </p>
            <p class="text-dark/40 text-sm">
              We hebben dit gedaan voor De Analoge Security Expert. De Circulaire Standaard hebben we bewust laten vallen na Gate 1 omdat het methodisch zwakker bleek en de klant voor ons op dat moment abstract was (zie <a href={url('/design/gate/')} class="underline hover:text-dark/60">gate-pagina</a> voor de onderbouwing).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Moodboard PowerPoint-overview als hoofdvisual -->
  <section class="bg-cream py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="reveal font-[family-name:var(--font-display)] text-3xl md:text-4xl font-bold text-dark mb-3 text-center">Moodboard in PowerPoint</h2>
      <p class="reveal reveal-delay-1 text-dark/50 text-center mb-6 max-w-2xl mx-auto">
        Zo zag onze concept collection eruit als presentatie-document. Hieronder de bewerkte beelden per cluster in grid-vorm; de volledige PowerPoint staat daaronder als download.
      </p>

      <div class="reveal reveal-delay-2 rounded-2xl overflow-hidden border border-dark/10 shadow-sm bg-white p-3 mb-6">
        <img src={url('/images/research/prototype/concept-collection-overview.png')} alt="Overzicht concept collection uit PowerPoint" class="w-full h-auto block rounded-xl" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
        <div style="display:none" class="bg-warm-gray/60 border border-dashed border-dark/20 rounded-xl p-10 text-center">
          <p class="text-dark/50 text-sm">Exporteer een overview-slide van de concept collection PowerPoint als <code>concept-collection-overview.png</code> naar <code>public/images/research/prototype/</code> om hem hier te tonen. Download van de volledige PowerPoint staat onder de grid.</p>
        </div>
      </div>

      <div class="reveal text-center">
        <a href={url('/concept-collection-security-expert.pptx')} download class="inline-flex items-center gap-2 bg-phase-design/10 hover:bg-phase-design/20 text-phase-design font-bold px-5 py-3 rounded-xl transition-colors border border-phase-design/20">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          Download volledige concept collection (PowerPoint)
        </a>
      </div>
    </div>
  </section>

  <!-- Waarom geen tweede concept collection (voor Circulaire Standaard) -->
  <section class="bg-warm-gray py-16">
    <div class="max-w-3xl mx-auto px-6">
      <div class="reveal bg-bg-elevated rounded-2xl p-6 md:p-8 border border-white/10 shadow-sm">
        <p class="text-dark/30 text-xs font-bold uppercase tracking-widest mb-3">Waarom geen tweede concept collection?</p>
        <p class="text-dark/60 text-sm leading-relaxed mb-3">
          De opdracht vraagt idealiter een concept collection per denkrichting. Wij hebben er 1 (Security Expert, bovenstaand). Voor Circulaire Standaard hebben we die stap niet gezet. Twee redenen, eerlijk benoemd:
        </p>
        <ol class="list-decimal pl-5 space-y-2 text-dark/60 text-sm leading-relaxed mb-3">
          <li>In de <a href={url('/design/gate/')} class="underline">DVF-afweging op Gate 1</a> zagen we dat Circulair's Desirability-voorsprong rustte op een bedachte klant, terwijl Security een geobserveerde klantpijn had (handtekeningfraude). Een concept collection voor een richting waarvan we de klant nog niet hadden gevonden, voelde als methodische afronding zonder richting om naartoe te werken.</li>
          <li>Een concept collection kost ons realistisch 3-4 uur inspiratie-verzameling, clustering en reflectie. We hebben die tijd liever ingezet in de richting die we wel hebben gekozen (prototyping iteratie 1 en 2 voor Security, later de pivot).</li>
        </ol>
        <p class="text-dark/60 text-sm leading-relaxed">
          <strong class="text-dark">Methodische schuld die we erkennen:</strong> als de Security-richting in fase 1 van de roadmap sneuvelt bij notaris-interviews, hebben we geen warm alternatief om op terug te vallen. In een commerciele setting zou dat onverantwoord zijn. In deze leeropdracht accepteren we het als bewuste concentratie van de focus, niet als vergetelheid.
        </p>
      </div>
    </div>
  </section>

  <!-- Kern-vragen concept collection (uit lesmateriaal) -->
  <section class="bg-cream py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="reveal font-[family-name:var(--font-display)] text-2xl md:text-3xl font-bold text-dark mb-3 text-center">Wat hebben we hiermee gedaan?</h2>
      <p class="reveal reveal-delay-1 text-dark/50 text-center mb-10">Vier vragen uit het lesmateriaal als kapstok</p>

      <div class="reveal reveal-delay-2 space-y-4">
        <div class="bg-bg-elevated rounded-2xl p-5 border border-white/5 shadow-sm">
          <p class="text-dark/40 text-xs font-bold uppercase tracking-wide mb-2">Hoe is dit al eens geprobeerd?</p>
          <p class="text-dark/70 text-sm leading-relaxed">
            In de digitale wereld: <a href="https://www.docusign.com/" target="_blank" rel="noopener" class="underline">DocuSign</a>, <a href="https://www.pkisigning.nl/" target="_blank" rel="noopener" class="underline">PKIsigning</a>, <a href="https://www.signicat.com/" target="_blank" rel="noopener" class="underline">Signicat</a>. In de fysiek-juridische wereld: <a href="https://www.knb.nl" target="_blank" rel="noopener" class="underline">notarissen</a> met ID-check-protocollen, banken met KYC-procedures. In consumentenmarkt: <a href="https://www.itsme-id.com/" target="_blank" rel="noopener" class="underline">itsme</a>, <a href="https://www.idin.nl/" target="_blank" rel="noopener" class="underline">iDIN</a>. Wat opviel: allemaal kiezen voor volledig-digitaal of voor mens-als-controleur. Niks op de brug daartussen.
          </p>
        </div>
        <div class="bg-bg-elevated rounded-2xl p-5 border border-white/5 shadow-sm">
          <p class="text-dark/40 text-xs font-bold uppercase tracking-wide mb-2">Waar lijkt dit op?</p>
          <p class="text-dark/70 text-sm leading-relaxed">
            Veel associaties met rituelen (lakzegel, handdruk, aankloppen) en materiaal-traditie (leer, goud, vulpen). Die kant helpt om merkwaarde en fysiek-gevoel te beladen. Aan de technische kant sloegen beelden aan van modulariteit (Lego), kluizen (lock, vault) en biometrie (fingerprint, iris).
          </p>
        </div>
        <div class="bg-bg-elevated rounded-2xl p-5 border border-white/5 shadow-sm">
          <p class="text-dark/40 text-xs font-bold uppercase tracking-wide mb-2">Wie is expert?</p>
          <p class="text-dark/70 text-sm leading-relaxed">
            In Nederland: de <a href="https://www.knb.nl" target="_blank" rel="noopener" class="underline">Koninklijke Notariele Beroepsorganisatie</a>, <a href="https://www.logius.nl/" target="_blank" rel="noopener" class="underline">Logius</a> (DigiD), <a href="https://www.acm.nl/" target="_blank" rel="noopener" class="underline">ACM</a> en certificeringsbureau's rond eIDAS. Academisch: security researchers bij TU Delft en Radboud. Praktijk: banken-KYC-teams en zelfstandig ID-verificatiedienstverleners zoals Jumio.
          </p>
        </div>
        <div class="bg-bg-elevated rounded-2xl p-5 border border-white/5 shadow-sm">
          <p class="text-dark/40 text-xs font-bold uppercase tracking-wide mb-2">Welke verbanden legden we?</p>
          <p class="text-dark/70 text-sm leading-relaxed">
            Drie belangrijke: (1) de octopus-associatie (meerdere verificaties tegelijk) bracht ons op het idee van gelaagde authenticatie ("iets dat je hebt + iets dat je weet + iets dat je bent"). (2) De lakzegel-associatie legde een brug tussen erfgoed en digitale audittrail: een zegel is altijd al een cryptografische koppeling geweest. (3) Het nadenken over "waarom eigenlijk een pen?" in deze verzameling was de kiem van de <a href={url('/refine/pivot/')} class="underline">latere pivot</a>. Die gedachte ("los van de pen") is hier geboren, niet tijdens de PELV-iteraties.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Convergentie: van beelden naar clusters -->
  <section class="bg-warm-gray py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="reveal font-[family-name:var(--font-display)] text-2xl md:text-3xl font-bold text-dark mb-3 text-center">Van beelden naar clusters</h2>
      <p class="reveal reveal-delay-1 text-dark/50 text-center mb-10">Na verzamelen hebben we drie bundels gemaakt als aanvliegroutes voor de prototype-fase</p>

      <!-- Productvormen en authenticatie -->
      <div class="reveal reveal-delay-2 grid md:grid-cols-2 gap-6 mb-8">
        <div class="bg-bg-elevated rounded-2xl p-6 border border-white/5 shadow-sm">
          <h3 class="font-[family-name:var(--font-display)] font-bold text-dark text-lg mb-2">Productvormen</h3>
          <p class="text-dark/40 text-sm mb-3">In welke vorm kan het zitten, als het niet per se een pen hoeft te zijn?</p>
          <ul class="space-y-2">
            {productvormen.map((item) => (
              <li class="text-dark/60 text-sm flex items-start gap-2">
                <span class="text-phase-design mt-0.5 text-xs">&#9679;</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-bg-elevated rounded-2xl p-6 border border-white/5 shadow-sm">
          <h3 class="font-[family-name:var(--font-display)] font-bold text-dark text-lg mb-2">Authenticatiemethoden</h3>
          <p class="text-dark/40 text-sm mb-3">Hoe bewijs je wie je bent? Breed kijken.</p>
          <ul class="space-y-2">
            {authenticatie.map((item) => (
              <li class="text-dark/60 text-sm flex items-start gap-2">
                <span class="text-phase-design mt-0.5 text-xs">&#9679;</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Kruisbestuivingen -->
      <div class="reveal">
        <h3 class="font-[family-name:var(--font-display)] font-bold text-dark text-lg mb-3">Wilde kruisbestuivingen</h3>
        <p class="text-dark/40 text-sm mb-6">Zeven onverwachte bronnen. Elk werd onze aanleiding om over een aspect nieuw na te denken.</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
          {kruisbestuivingen.map((item) => (
            <div class="bg-bg-elevated rounded-xl p-4 border border-white/5 shadow-sm">
              <h4 class="font-[family-name:var(--font-display)] font-bold text-dark text-sm mb-1">{item.naam}</h4>
              <p class="text-dark/50 text-xs leading-relaxed">{item.waarom}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Kiem voor pivot expliciet -->
      <div class="reveal mt-10 bg-phase-refine/10 border-l-4 border-phase-refine rounded-2xl p-6">
        <p class="text-dark/30 text-xs font-bold uppercase tracking-widest mb-2">Wat we toen niet wisten</p>
        <p class="text-dark/70 text-sm leading-relaxed">
          Dit losmaken van de pen bleek achteraf cruciaal. Tijdens het verzamelen viel op dat veel goede associaties juist niet over pennen gingen. Die gedachte droegen we mee naar de prototype-fase en daar kwam de pivot van: het idee dat de pen in het verificatieproces overbodig was. Zie <a href={url('/refine/pivot/')} class="underline">de pivot-pagina</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Download -->
  <section class="bg-cream py-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="reveal">
        <h2 class="font-[family-name:var(--font-display)] text-2xl font-bold text-dark mb-4">De volledige PowerPoint-moodboard</h2>
        <p class="text-dark/50 mb-6">Een slide met alle beelden op volle resolutie. Dezelfde inhoud als hierboven, maar in presentatievorm.</p>
        <a href={url('/concept-collection-security-expert.pptx')} class="inline-flex items-center gap-2 bg-phase-design text-white font-bold px-6 py-3 rounded-full hover:scale-105 transition-transform" download>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></svg>
          Download PowerPoint
        </a>
      </div>
    </div>
  </section>

  <!-- Navigation -->
  <section class="bg-bg-primary text-white py-16">
    <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <a href={url('/design/gate/')} class="reveal inline-flex items-center gap-2 text-white/50 hover:text-white font-bold transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
        Gate
      </a>
      <a href={url('/refine/')} class="reveal reveal-delay-1 inline-flex items-center gap-2 bg-phase-refine text-white font-bold px-6 py-3 rounded-full hover:scale-105 transition-transform">
        Naar Refine (Fase 4)
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </div>
  </section>
</BaseLayout>
