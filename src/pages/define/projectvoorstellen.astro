---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils/base';

const voorstellen = [
  {
    id: 'security',
    gekozen: true,
    nummer: 1,
    titel: 'Analoge Security Expert',
    pitch: 'Aurora als kennispartij rond de integriteit van het getekende moment, met een fysiek verificatie-device dat NFC-ID en PIN koppelt aan de papieren handtekening.',
    probleem: {
      wie: 'Notariskantoren, banken bij balieprocessen, verzekeraars en juridische kantoren die nog met papieren handtekeningen werken.',
      wat: 'Een handgeschreven handtekening is geen identiteitsbewijs meer. Visuele ID-checks zijn foutgevoelig. In 2024 rapporteerde Signicat +2.137% deepfake-fraudepogingen in 3 jaar.',
      nu: 'DOBV (digitaal BV oprichten) is sinds 2024 wettelijk mogelijk, en het Programma Digitaal Passeren van de KNB breidt dit uit naar meer akten. Voor rechtsgebieden waar de fysieke akte voorlopig verplicht blijft, is er nog geen gecertificeerde hybride oplossing.',
    },
    oplossing: 'Fysiek station bij de balie met NFC-uitlezing van het paspoort of ID-kaart, pincode-invoer door de klant, en een cryptografische koppeling van het verificatie-moment aan het document via een unieke auditcode. Papier blijft het rechtsgeldige exemplaar; de digitale koppeling levert het bewijs dat de juiste persoon tekende.',
    team: [
      { rol: 'Productontwerp + tech-interface', wie: 'Product-lead / generator-profiel' },
      { rol: 'Partnerships en techpartner-selectie', wie: 'Commercial-lead met sterk netwerk-profiel' },
      { rol: 'Eerste klantgesprekken en onboarding-verhaal', wie: 'Operations-lead met motivator-/luisteraar-profiel' },
      { rol: 'Open gat', wie: 'Financieel-operationele kant (Tabulating): vraagt om een aanvullende hire' },
    ],
    looptijd: '9 maanden naar werkend MVP',
    budget: 'ordegrootte €350-500k voor eerste pilot-klare versie met techpartner',
    success: 'Minstens 1 pilotklant (notariskantoor) tekent intentieverklaring binnen 6 maanden. N=3+ notarisgesprekken bevestigen de pijn zonder dat wij de richting voorkauwen.',
    afbreek: 'Na 3 notaris-gesprekken geen bevestiging van de fraudepijn of dossiertijd-pijn. Of: techpartner-schatting boven €1 mln voor MVP. Of: EUDI-wallet landelijk versneld uitgerold met notariele inpassing voor 2027.',
    bewijs: [
      { naam: 'Gate 1 (DVF)', link: '/design/gate/' },
      { naam: 'Concept collection', link: '/design/concept-collection/' },
      { naam: 'Prototyping (PELV)', link: '/refine/prototyping/' },
      { naam: 'Pivot naar digitaal verificatieproces', link: '/refine/pivot/' },
      { naam: 'Proof of Value', link: '/deliver/proof-of-value/' },
    ],
    opmerking: 'Dit was onze oorspronkelijke intentie voor Design. In Refine is de richting omgebogen naar een digitaal verificatieproces waarbij de pen niet meer het kerngereedschap is; de positionering als "expert in getekende integriteit" blijft gelijk.',
  },
  {
    id: 'circulair',
    gekozen: false,
    nummer: 2,
    titel: 'Circulaire Standaard',
    pitch: 'Aurora als norm-zetter voor circulaire schrijfwaren in Noord- en West-Europa, met een gecertificeerde open standaard en een take-back / refillable-model voor eigen productportfolio.',
    probleem: {
      wie: 'Schrijfwaren-fabrikanten in de EU die richting de ESPR en Digital Product Passport moeten bewegen. Zakelijke inkopers die op duurzaamheid moeten rapporteren (CSRD). Indirect: onderwijs- en kantoorinkopers.',
      wat: 'De EU dwingt fabrikanten tot transparantie en circulariteit, maar er is geen Nederlandse of Europese norm-zetter voor schrijfwaren specifiek. Wie bepaalt wat "circulaire pen" betekent, heeft een positie.',
      nu: 'ESPR treedt gefaseerd in werking vanaf 2026. Digital Product Passport wordt per productgroep ingevoerd. Wie nu een standaard zet, definieert de markt voor de komende 10 jaar.',
    },
    oplossing: 'Open standaard voor circulair schrijfwaren-gebruik: take-back-programma, bio-based of gerecyclede materialen per product-categorie, meetbare lifecycle-impact per SKU. Aurora certificeert andere merken tegen deze standaard (licentiemodel) en positioneert eigen portfolio als referentie-implementatie.',
    team: [
      { rol: 'Standaardisatie-netwerk en partnerships', wie: 'Commercial-lead met netwerk-profiel' },
      { rol: 'Regelgevings- en content-onderbouwing (ESPR, DPP, CSRD)', wie: 'Content-lead met absorbing-profiel' },
      { rol: 'Productdesign en materiaalkeuze', wie: 'Product-lead / generator-profiel' },
      { rol: 'Open gat', wie: 'Certificeringsauditor-ervaring: in te huren of in samenwerking met een bestaande certificerende instantie' },
    ],
    looptijd: '12 maanden naar standaarddocument + proof-of-concept take-back',
    budget: 'ordegrootte €250-400k (juridische/technische opstelling standaard, pilot take-back-logistiek)',
    success: 'Minstens 3 andere schrijfwaren-fabrikanten omarmen de standaard binnen 18 maanden. Erkenning door een certificerende instantie (bv. NEN) of brancheorganisatie.',
    afbreek: 'Geen commitment van andere fabrikanten binnen 6 maanden. Of: EU rolt een eigen certificering uit voor schrijfwaren die onze standaard overbodig maakt.',
    bewijs: [
      { naam: 'Innovatieradar kamer Organisatie', link: '/define/innovatieradar/' },
      { naam: 'Denkrichting 2', link: '/define/denkrichtingen/' },
    ],
    opmerking: 'Bewust niet gekozen in Gate 1. Desirability-score was lager omdat onze klant bedacht was, niet geobserveerd. Het voorstel is hier alsnog uitgewerkt om transparant te laten zien dat het een serieuze kandidaat was en welke argumentatie de richting kan doen terugkeren als externe omstandigheden veranderen (bv. versnelde ESPR-implementatie).',
  },
];
---

<BaseLayout title="Projectvoorstellen · Define">
  <!-- Hero -->
  <section class="bg-bg-primary text-white overflow-hidden relative">
    <div class="absolute inset-0 bg-gradient-to-b from-phase-define/10 to-bg-primary"></div>

    <div class="max-w-5xl mx-auto px-6 py-16 md:py-24 relative z-10">
      <nav class="reveal text-sm mb-6 flex items-center gap-2">
        <a href={url('/')} class="text-white/40 hover:text-white/60 transition-colors">Home</a>
        <span class="text-white/20">/</span>
        <a href={url('/define/')} class="text-white/40 hover:text-white/60 transition-colors">Define</a>
        <span class="text-white/20">/</span>
        <span class="text-phase-define font-medium">Projectvoorstellen</span>
      </nav>
      <h1 class="reveal reveal-delay-1 font-[family-name:var(--font-display)] text-5xl md:text-7xl font-bold leading-[0.95] mb-4">
        Project<span class="gradient-text">voorstellen</span>
      </h1>
      <p class="reveal reveal-delay-2 text-xl text-white/60 max-w-3xl leading-relaxed">
        Twee denkrichtingen, twee projectvoorstellen. Eentje gekozen voor Design, eentje bewust op de plank.
      </p>
      <div class="reveal reveal-delay-3 w-24 h-1.5 rounded-full bg-phase-define mt-8"></div>
    </div>
  </section>

  <!-- Voorstellen -->
  <section class="bg-warm-gray py-16">
    <div class="max-w-5xl mx-auto px-6 space-y-12">
      {voorstellen.map((v) => (
        <div class={`reveal bg-bg-elevated rounded-3xl p-8 md:p-10 shadow-sm ${v.gekozen ? 'border-2 border-phase-design/40' : 'border border-white/10'}`}>
          <!-- Header -->
          <div class="flex items-start justify-between gap-4 mb-6 flex-wrap">
            <div class="flex items-start gap-4">
              <div class={`w-12 h-12 ${v.gekozen ? 'bg-phase-design' : 'bg-dark/20'} rounded-2xl flex items-center justify-center text-white text-xl font-bold`}>
                {v.nummer}
              </div>
              <div>
                <h2 class="font-[family-name:var(--font-display)] text-2xl md:text-3xl font-bold text-dark">{v.titel}</h2>
                <p class="text-dark/50 text-sm mt-1">{v.pitch}</p>
              </div>
            </div>
            {v.gekozen && (
              <span class="bg-phase-design/15 text-phase-design px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest self-start">Gekozen in Gate 1</span>
            )}
            {!v.gekozen && (
              <span class="bg-dark/10 text-dark/60 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest self-start">Bewust op de plank</span>
            )}
          </div>

          <!-- Probleem -->
          <div class="mb-6">
            <p class="text-dark/30 text-xs font-bold uppercase tracking-widest mb-2">Probleem</p>
            <dl class="space-y-2 text-sm">
              <div><dt class="inline font-bold text-dark/80">Wie heeft last: </dt><dd class="inline text-dark/70">{v.probleem.wie}</dd></div>
              <div><dt class="inline font-bold text-dark/80">Wat speelt: </dt><dd class="inline text-dark/70">{v.probleem.wat}</dd></div>
              <div><dt class="inline font-bold text-dark/80">Waarom nu: </dt><dd class="inline text-dark/70">{v.probleem.nu}</dd></div>
            </dl>
          </div>

          <!-- Oplossing -->
          <div class="mb-6 bg-phase-define/5 border-l-4 border-phase-define rounded-r-xl p-5">
            <p class="text-dark/30 text-xs font-bold uppercase tracking-widest mb-2">Oplossing (hoogover)</p>
            <p class="text-dark/70 text-sm leading-relaxed">{v.oplossing}</p>
          </div>

          <!-- Grid: team, looptijd/budget, success/afbreek -->
          <div class="grid md:grid-cols-2 gap-4 mb-6">
            <!-- Team -->
            <div class="bg-white/40 rounded-xl p-5">
              <p class="text-dark/30 text-xs font-bold uppercase tracking-widest mb-3">Taakverdeling en profielen</p>
              <ul class="space-y-2 text-dark/70 text-sm">
                {v.team.map((t) => (
                  <li><strong class="text-dark">{t.rol}:</strong> {t.wie}</li>
                ))}
              </ul>
            </div>

            <!-- Looptijd + budget -->
            <div class="bg-white/40 rounded-xl p-5">
              <p class="text-dark/30 text-xs font-bold uppercase tracking-widest mb-3">Scope</p>
              <dl class="space-y-2 text-dark/70 text-sm">
                <div><dt class="font-bold text-dark">Looptijd:</dt><dd>{v.looptijd}</dd></div>
                <div><dt class="font-bold text-dark">Budget:</dt><dd>{v.budget}</dd></div>
              </dl>
            </div>
          </div>

          <!-- Success / afbreek -->
          <div class="grid md:grid-cols-2 gap-4 mb-6">
            <div class="bg-phase-deliver/5 rounded-xl p-5 border-l-4 border-phase-deliver">
              <p class="text-dark/30 text-xs font-bold uppercase tracking-widest mb-2">Success-criterium</p>
              <p class="text-dark/70 text-sm">{v.success}</p>
            </div>
            <div class="bg-phase-discover/5 rounded-xl p-5 border-l-4 border-phase-discover">
              <p class="text-dark/30 text-xs font-bold uppercase tracking-widest mb-2">Afbreek-criterium</p>
              <p class="text-dark/70 text-sm">{v.afbreek}</p>
            </div>
          </div>

          <!-- Bewijs + opmerking -->
          <div class="flex flex-wrap gap-2 mb-4">
            {v.bewijs.map((b) => (
              <a href={url(b.link)} class="inline-flex items-center gap-1.5 text-xs bg-phase-define/10 text-phase-define border border-phase-define/20 hover:bg-phase-define/20 px-3 py-1.5 rounded-full transition-colors">
                <span>&rarr;</span>{b.naam}
              </a>
            ))}
          </div>

          {v.opmerking && (
            <p class="text-dark/50 text-xs italic leading-relaxed border-t border-dark/10 pt-3 mt-3">
              <strong class="text-dark/60 not-italic">Opmerking: </strong>{v.opmerking}
            </p>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Navigatie -->
  <section class="bg-bg-primary text-white py-16">
    <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <a href={url('/define/denkrichtingen/')} class="reveal inline-flex items-center gap-2 text-white/50 hover:text-white font-bold transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Denkrichtingen
      </a>
      <div class="reveal reveal-delay-1 text-center">
        <p class="text-white/40 text-sm mb-3">Verder naar Design</p>
        <a href={url('/design/')} class="inline-flex items-center gap-2 bg-phase-design text-white font-bold px-6 py-3 rounded-full hover:scale-105 transition-transform">
          Naar Design (Fase 3)
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
