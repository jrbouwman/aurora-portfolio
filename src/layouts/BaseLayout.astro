---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import { url } from '../utils/base';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio Innovatiemanagement - Aurora Writing Instruments Group' } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&family=Patrick+Hand&display=swap" rel="stylesheet" />
    <title>{title} | Aurora Portfolio</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- SVG Filters for hand-drawn effect -->
    <svg style="position:absolute;width:0;height:0">
      <filter id="sketchy">
        <feTurbulence type="turbulence" baseFrequency="0.02" numOctaves="3" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2" />
      </filter>
    </svg>

    <Navigation />

    <main class="flex-1">
      <slot />
    </main>

    <!-- Global image lightbox -->
    <div id="img-lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 backdrop-blur-sm p-4 md:p-8 cursor-zoom-out">
      <button type="button" id="img-lightbox-close" class="absolute top-4 right-4 md:top-8 md:right-8 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors z-10" aria-label="Sluiten">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <img id="img-lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain cursor-default" />
      <p id="img-lightbox-caption" class="absolute bottom-4 md:bottom-8 left-0 right-0 text-center text-white/70 text-sm px-8"></p>
    </div>

    <footer class="bg-bg-secondary border-t border-white/5 py-10 mt-0">
      <div class="max-w-6xl mx-auto px-6 text-center text-sm">
        <div class="flex items-center justify-center gap-3 mb-3">
          <svg viewBox="0 0 32 32" class="w-8 h-8" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="aurora-footer" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#3B82F6"/>
                <stop offset="50%" stop-color="#8B5CF6"/>
                <stop offset="100%" stop-color="#F47264"/>
              </linearGradient>
            </defs>
            <rect width="32" height="32" rx="7" fill="#161427"/>
            <g transform="translate(16,16) rotate(-20) translate(-16,-16)">
              <rect x="13" y="4" width="6" height="16" rx="2" fill="url(#aurora-footer)"/>
              <path d="M13,20 L16,28 L19,20 Z" fill="url(#aurora-footer)"/>
              <rect x="19.5" y="5" width="1.5" height="9" rx="0.75" fill="white" opacity="0.35"/>
              <circle cx="16" cy="27" r="1" fill="white" opacity="0.7"/>
            </g>
          </svg>
          <div>
            <span class="text-text-primary font-[family-name:var(--font-display)] text-lg">Aurora</span>
            <span class="text-accent-magenta ml-1">Beyond Paper</span>
          </div>
        </div>
        <p class="text-text-muted mb-1">Portfolio Innovatiemanagement (EDIM.21) &bull; Technische Bedrijfskunde &bull; Hogeschool Windesheim, Zwolle</p>
        <p class="text-text-muted/60">Anke Maassen van den Brink &bull; Lianne van Os &bull; Jr Bouwman</p>
      </div>
    </footer>

    <!-- Scroll reveal script -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach((el) => {
        observer.observe(el);
      });
    </script>

    <!-- Fase-tabs script (used on roadmap adopter-strategie) -->
    <script>
      (() => {
        const tabs = document.querySelectorAll<HTMLButtonElement>('[data-fase-tab]');
        const panels = document.querySelectorAll<HTMLElement>('[data-fase-panel]');
        if (tabs.length === 0 || panels.length === 0) return;

        const activate = (num: string) => {
          tabs.forEach((t) => t.classList.toggle('is-active', t.dataset.faseTab === num));
          panels.forEach((p) => p.classList.toggle('hidden', p.dataset.fasePanel !== num));
        };

        tabs.forEach((t) => {
          t.addEventListener('click', () => activate(t.dataset.faseTab || '1'));
        });

        // Respond to anchor changes (clicks from SVG markers)
        const handleHash = () => {
          const m = window.location.hash.match(/^#fase-(\d)$/);
          if (m) {
            activate(m[1]);
            const panel = document.getElementById(`fase-${m[1]}`);
            if (panel) {
              setTimeout(() => panel.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
            }
          }
        };
        window.addEventListener('hashchange', handleHash);
        handleHash();
      })();
    </script>

    <!-- Image lightbox script -->
    <script>
      (() => {
        const lightbox = document.getElementById('img-lightbox');
        const lightboxImg = document.getElementById('img-lightbox-img') as HTMLImageElement | null;
        const lightboxCaption = document.getElementById('img-lightbox-caption');
        const closeBtn = document.getElementById('img-lightbox-close');
        if (!lightbox || !lightboxImg || !lightboxCaption || !closeBtn) return;

        const open = (src: string, alt: string) => {
          lightboxImg.src = src;
          lightboxImg.alt = alt;
          lightboxCaption.textContent = alt;
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        };
        const close = () => {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
          lightboxImg.src = '';
          document.body.style.overflow = '';
        };

        const isDecorative = (img: HTMLImageElement): boolean => {
          if (img.closest('[data-no-lightbox]')) return true;
          if (img.dataset.noLightbox !== undefined) return true;
          const cls = img.className || '';
          if (/opacity-(5|10|15|20|25)\b/.test(cls)) return true;
          if (cls.includes('pointer-events-none')) return true;
          if (img.closest('a')) return true;
          if (img.closest('button')) return true;
          if (img.width > 0 && img.width < 64) return true;
          return false;
        };

        const enableImg = (img: HTMLImageElement) => {
          if (img.dataset.lightboxEnabled === '1') return;
          if (isDecorative(img)) return;
          img.dataset.lightboxEnabled = '1';
          img.style.cursor = 'zoom-in';
          img.addEventListener('click', (e) => {
            e.preventDefault();
            open(img.currentSrc || img.src, img.alt || '');
          });
        };

        document.querySelectorAll<HTMLImageElement>('img').forEach(enableImg);

        const mo = new MutationObserver((muts) => {
          muts.forEach((m) => {
            m.addedNodes.forEach((n) => {
              if (n instanceof HTMLImageElement) enableImg(n);
              else if (n instanceof HTMLElement) n.querySelectorAll<HTMLImageElement>('img').forEach(enableImg);
            });
          });
        });
        mo.observe(document.body, { childList: true, subtree: true });

        lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
        closeBtn.addEventListener('click', close);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) close(); });
      })();
    </script>
  </body>
</html>
